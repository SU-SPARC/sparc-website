# SPARC website environment. Copy to .env.local (gitignored) and fill in.
# Local values come from `supabase status -o env` after `npm run db:start`.

# Supabase project URL. Local: http://127.0.0.1:55321 (this project's ports are
# pinned to 55321-55329 in supabase/config.toml). Hosted: https://<ref>.supabase.co
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:55321

# Public client key: sb_publishable_... (PUBLISHABLE_KEY in `supabase status`).
# A legacy anon JWT also works; NEXT_PUBLIC_SUPABASE_ANON_KEY is accepted as a
# fallback name.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Base URL of the site, used to build auth redirect links (invites, resets).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# SERVER ONLY. sb_secret_... (SECRET_KEY in `supabase status`). Bypasses RLS.
# Used by the account-creation server actions, the seed script and
# scripts/rls-check.ts. Never prefix with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=

# Server only. Set to true (on Vercel) once custom SMTP is configured in
# Supabase (docs/CMS.md, section 2); it enables the "Send invite email" option
# in /admin/accounts/new. Leave false while only the built-in sender exists.
AUTH_SMTP_CONFIGURED=false

# Seed script only: the shared e-board admin login it creates.
SEED_ADMIN_EMAIL=sparc@studentorgs.suffolk.edu
SEED_ADMIN_PASSWORD=change-me-locally
